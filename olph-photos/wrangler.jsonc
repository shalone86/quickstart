{
  "name": "olph-photos",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/share"] },
  "routes": [{ "pattern": "photos.shalonely.com", "custom_domain": true }],
  "workers_dev": false,
  // GHOST_URL, GHOST_ADMIN_KEY, PASSCODE, SESSION_SECRET (and TIMEZONE/TAG if set) live in the
  // Cloudflare dashboard; keep_vars stops a deploy from wiping them.
  "keep_vars": true
}
